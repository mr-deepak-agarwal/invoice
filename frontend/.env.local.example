# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (never prefix these with NEXT_PUBLIC_ — they must not
# reach client-side JS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GEMINI_API_KEY=your-gemini-api-key
# Optional. Leave unset to use the built-in list of current free models
# (gemini-3.5-flash-lite first). Do NOT set gemini-2.5-flash — Google now
# limits it to existing users and new keys get "model not found".
# GEMINI_MODEL=gemini-3.5-flash-lite

# Telegram bot (see README → "Connect Telegram")
TELEGRAM_BOT_TOKEN=token-from-BotFather
# Any long random string you invent. Must match the secret_token you pass to setWebhook.
TELEGRAM_WEBHOOK_SECRET=long-random-string
# Bot username without the @ (used to build the one-tap connect link)
TELEGRAM_BOT_USERNAME=YourBotName_bot
# Optional: your site URL, so the bot can link to the invoice it created
APP_URL=https://your-app.vercel.app
